# Variáveis opcionais do docker-compose.yml (desenvolvimento LOCAL).
# Copie para `.env` na raiz para sobrescrever os padrões. Todos os valores
# abaixo são fictícios; nunca coloque segredos reais aqui.
# Lista completa de variáveis por serviço: docs/runbooks/matriz-env-operacional.md

# Portas publicadas no host (mude se já houver algo usando a porta)
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=10000
FRONT_HOST_PORT=3000
SCRAPYD_HOST_PORT=8080

# Banco local
DB_NAME=ai_urban
DB_PASSWORD=urban_local_root

# Segredos fictícios de desenvolvimento
JWT_SECRET=local_dev_jwt_secret_nao_usar_em_producao
NEXTAUTH_SECRET=local_dev_nextauth_secret_nao_usar_em_producao
HEALTH_READINESS_TOKEN=local_health_token
EVENTS_INGEST_API_KEY=local_ingest_key
SCRAPYD_API_KEY=local_scrapyd_key

# Seed de desenvolvimento (npm run seed:dev; ver CONTRIBUTING.md, "Logar localmente").
# SEED_DEV_ON_BOOT=true semeia sozinho a cada boot do backend, apos as migrations.
# Logins locais criados (valores ficticios, so para o ambiente local):
#   anfitriao: host@urban.local   admin: admin@urban.local   senha: UrbanLocal#2026
# O seed recusa rodar fora de ambiente local.
SEED_DEV_ON_BOOT=false

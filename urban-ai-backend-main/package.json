{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:coverage:critical": "jest --config jest.critical-coverage.config.cjs --runInBand --coverage knn-engine/backtesting.spec.ts payments/stripe-price-id.resolver.spec.ts",
    "test:coverage:auth": "jest --config src/auth/jest.coverage.config.cjs --runInBand --silent",
    "test:coverage:stays": "jest --config src/stays/jest.coverage.config.cjs --runInBand --silent",
    "test:coverage:health-cron": "jest --config src/health/jest.coverage.config.cjs --runInBand --silent",
    "test:coverage:certified": "npm run test:coverage:critical && npm run test:coverage:auth && npm run test:coverage:stays && npm run test:coverage:health-cron",
    "test:contracts": "jest --runInBand --testPathPatterns=contract.spec.ts",
    "contract:openapi": "jest --runInBand src/openapi/openapi-compatibility.contract.spec.ts",
    "audit:lgpd": "node scripts/lgpd-controls-audit.js",
    "audit:lgpd:self-test": "node scripts/lgpd-controls-audit.js --self-test",
    "audit:observability": "node scripts/observability-controls-audit.js",
    "audit:observability:self-test": "node scripts/observability-controls-audit.js --self-test",
    "audit:authorization": "node scripts/authorization-controls-audit.js",
    "audit:authorization:self-test": "node scripts/authorization-controls-audit.js --self-test",
    "audit:body-dtos": "node scripts/body-dto-runtime-audit.js",
    "audit:cron": "node scripts/scheduled-jobs-audit.js",
    "audit:cron:strict": "node scripts/scheduled-jobs-audit.js --strict",
    "audit:cron:self-test": "node scripts/scheduled-jobs-audit.js --self-test",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "typeorm": "typeorm-ts-node-commonjs -d src/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate src/migrations/$npm_config_name",
    "migration:create": "typeorm-ts-node-commonjs migration:create src/migrations/$npm_config_name",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "backfill:geocoder": "ts-node -r tsconfig-paths/register scripts/backfill-geocoder.ts",
    "backfill:geocoder:dry": "ts-node -r tsconfig-paths/register scripts/backfill-geocoder.ts --dry-run",
    "preflight:track3": "node scripts/track3-preflight.js",
    "preflight:track3:strict": "node scripts/track3-preflight.js --strict",
    "audit:migrations": "node scripts/audit-migrations.js",
    "audit:migrations:strict": "node scripts/audit-migrations.js --strict",
    "backup:mysql": "node scripts/mysql-backup.js",
    "backup:mysql:dry": "node scripts/mysql-backup.js --dry-run",
    "backup:mysql:self-test": "node scripts/mysql-backup.js --self-test",
    "restore:verify": "node scripts/restore-drill-verify.js",
    "restore:verify:dry": "node scripts/restore-drill-verify.js --dry-run",
    "restore:verify:self-test": "node scripts/restore-drill-verify.js --self-test",
    "smoke:airbnb-headless": "node scripts/test-airbnb-headless-scraper.js",
    "smoke:event-intelligence": "node scripts/event-intelligence-api-smoke.js",
    "cleanup:legacy-user": "node scripts/cleanup-user-legacy-data.js",
    "provision:staging-smoke-users": "node scripts/provision-staging-smoke-users.js",
    "provision:staging-auth-fixtures": "node scripts/staging-auth-fixtures.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bull": "^11.0.3",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@sentry/nestjs": "^10.43.0",
    "@turf/turf": "^7.3.4",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "generate-password": "^1.7.1",
    "generate-password-ts": "^1.6.5",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "ml-knn": "^3.0.0",
    "multer": "^2.2.0",
    "mysql2": "^3.19.1",
    "p-limit": "^6.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "playwright-core": "^1.59.1",
    "raw-body": "^3.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "source-map-support": "^0.5.21",
    "stripe": "^18.4.0",
    "typeorm": "^0.3.20",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.28",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.64.0"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "lodash": "4.18.1",
    "qs": "6.15.3",
    "uuid": "$uuid"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.spec.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "modulePaths": [
      "<rootDir>/.."
    ]
  }
}

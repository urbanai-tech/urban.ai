{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Urban AI Design Tokens",
  "type": "object",
  "required": ["name", "version", "primitives", "semantic", "componentAliases"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "primitives": { "type": "object", "minProperties": 1 },
    "semantic": {
      "type": "object",
      "required": ["light", "dark"],
      "properties": {
        "light": { "$ref": "#/$defs/theme" },
        "dark": { "$ref": "#/$defs/theme" }
      },
      "additionalProperties": false
    },
    "componentAliases": {
      "type": "object",
      "required": ["app", "admin"],
      "properties": {
        "app": { "$ref": "#/$defs/tokenMap" },
        "admin": { "$ref": "#/$defs/tokenMap" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "theme": {
      "type": "object",
      "required": ["page", "public", "app", "admin"],
      "additionalProperties": { "$ref": "#/$defs/tokenMap" }
    },
    "tokenMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}

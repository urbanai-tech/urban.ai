# Urban AI Frontend — .env.example
# Copie para `.env.local` para dev ou configure no Railway para prod.
# Nunca commite valores reais.

# === Ambiente ===
# production | staging | development
# Em staging, o NEXT_PUBLIC_APP_ENV="staging" faz aparecer banner amarelo no topo
# e separar os eventos no Sentry (tag environment=staging).
NEXT_PUBLIC_APP_ENV=production

# === API do backend ===
# Prod: https://urbanai-production-85fd.up.railway.app
# Staging: https://urban-ai-backend-staging-staging.up.railway.app
# Dev: http://localhost:10000
NEXT_PUBLIC_API_URL=https://urbanai-production-85fd.up.railway.app

# Fallbacks de contrato/mock usados apenas para desenvolvimento interno.
# Em production/staging real, mantenha false para nao mascarar endpoints quebrados.
NEXT_PUBLIC_ENABLE_CONTRACT_FALLBACK=false

# === URLs do site (Opção B — subdomain split) ===
# Site público (myurbanai.com) e app (app.myurbanai.com) compartilham o
# mesmo deploy do Next, mas a landing/header/footer públicos linkam para
# o app via NEXT_PUBLIC_APP_URL. Em dev local, deixa relativo.
NEXT_PUBLIC_APP_URL=https://app.myurbanai.com
NEXT_PUBLIC_MARKETING_URL=https://myurbanai.com

# === Stripe (somente publishable key no front) ===
# sk_* NUNCA vai para o front.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# === NextAuth ===
# URL do app (prod: https://app.myurbanai.com; dev: http://localhost:3000)
NEXTAUTH_URL=https://app.myurbanai.com
# Gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=
# Google OAuth (painel Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Sentry (opcional em dev, obrigatório em prod) ===
NEXT_PUBLIC_SENTRY_DSN=
# Apenas CI/build de release com upload de sourcemaps para Sentry.
SENTRY_AUTH_TOKEN=

# === Chainlit Copilot ===
# F5C.1 #12 do roadmap: migrar IP hardcoded de `next.config.ts` para essa var.
NEXT_PUBLIC_CHAINLIT_URL=http://localhost:8000

# Opcional: preenche automaticamente o painel /admin/alpha em ambientes internos.
# Deixe vazio em producao para evitar auditoria presa a um usuario especifico.
NEXT_PUBLIC_ADMIN_ALPHA_DEFAULT_EMAIL=

# === E2E / CI ===
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:10000
# Configurar somente em CI/staging. Nunca commitar credenciais reais.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_AUTH_EMAIL=
E2E_AUTH_PASSWORD=
E2E_HOST_EMAIL=
E2E_HOST_PASSWORD=
E2E_ALPHA_EMAIL=

# === Analytics ===
# Formato GA4 property ID (começa com G-). Deixar vazio desativa o script.
# Ativo apenas quando NEXT_PUBLIC_APP_ENV=production, para não poluir relatórios.
NEXT_PUBLIC_GA4_ID=
# Meta Pixel ID (15–16 dígitos). Deixar vazio desativa o script.
NEXT_PUBLIC_META_PIXEL_ID=

# === SEO / SGO / GEO - conectores server-side opcionais ===
# Usados apenas por rotas/admin server-side. Nunca exponha valores reais no client.
SEO_GSC_SITE_URL=https://myurbanai.com/
SEO_GA4_PROPERTY_ID=
SEO_GOOGLE_CLIENT_EMAIL=
# Use \n escapado na private key.
SEO_GOOGLE_PRIVATE_KEY=
SEO_BOT_LOG_SOURCE=
SEO_BOT_LOG_LOCAL_PATH=
SEO_BOT_LOG_ENDPOINT=
SEO_BOT_LOG_TOKEN=
SEO_AI_MONITOR_SOURCE=
SEO_AI_MONITOR_DATASET_PATH=
SEO_AI_MONITOR_ENDPOINT=
SEO_AI_MONITOR_API_KEY=

# === Waitlist / lista de interesse ===
# Endpoint para onde o formulário de pré-cadastro (WaitlistForm) envia POST.
# Opções comuns para MVP (zero backend):
#  - Formspark: https://submit-form.com/<FORM_ID>
#  - Formspree: https://formspree.io/f/<FORM_ID>
#  - Getform: https://getform.io/f/<FORM_ID>
# Ou endpoint próprio quando criar /waitlist no backend.
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# === F8 — Pré-lançamento ===
# Fallback opcional caso /public-config não responda. Em produção é melhor
# deixar o backend ditar via PRELAUNCH_MODE — assim Gustavo liga/desliga sem
# rebuild do front. Aqui é só rede de segurança para dev local offline.
NEXT_PUBLIC_PRELAUNCH_MODE=false

{
  "name": "urbanfront",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run bundle:check",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "design:tokens:generate": "node scripts/design-tokens.mjs",
    "design:tokens:check": "node scripts/design-tokens.mjs --check",
    "design:tokens:test": "node --test scripts/design-tokens.test.mjs",
    "design:debt:check": "node scripts/design-debt-audit.mjs",
    "design:debt:self-test": "node --test scripts/design-debt-audit.test.mjs",
    "design:debt:update": "node scripts/design-debt-audit.mjs --update-baseline",
    "design:catalog:check": "node scripts/design-component-catalog.mjs",
    "design:contrast:check": "node scripts/design-glass-contrast.mjs --check",
    "design:audit": "npm run design:tokens:check && npm run design:contrast:check && node scripts/design-system-audit.mjs && npm run design:debt:check && npm run design:catalog:check",
    "bundle:report": "node scripts/bundle-budget.mjs",
    "bundle:check": "node scripts/bundle-budget.mjs --check",
    "bundle:test": "node --test scripts/bundle-budget.test.mjs",
    "auth:compat:test": "node --test scripts/next-auth-uuid.test.mjs",
    "onboarding:unit:test": "node --test scripts/onboarding-domain.test.mjs",
    "event-radar:unit:test": "node --test scripts/event-radar-domain.test.mjs",
    "event-radar:api-contract:test": "node --test scripts/event-radar-api-contract.test.mjs",
    "error-boundary:unit:test": "node --test scripts/error-recovery.test.mjs",
    "pwa:lifecycle:test": "node --test scripts/pwa-lifecycle.test.mjs scripts/pwa-sw-routing.test.mjs scripts/pwa-install.test.mjs",
    "ui-primitives:unit:test": "node --test scripts/ui-primitives.test.mjs",
    "privacy-scrub:unit:test": "node --test scripts/privacy-scrub.test.mjs",
    "csp:contract:test": "node --test scripts/csp-contract.test.mjs",
    "host-baseline:unit:test": "node --test scripts/host-baseline.test.mjs",
    "public-site:contract:test": "node --test scripts/public-site-contract.test.mjs",
    "app-noindex:contract:test": "node --test scripts/app-noindex-contract.test.mjs",
    "aplicar-preco:unit:test": "node --test scripts/aplicar-preco-domain.test.mjs",
    "beta-ops:unit:test": "node --test scripts/beta-ops-domain.test.mjs",
    "forbidden-policy:unit:test": "node --test scripts/forbidden-policy.test.mjs",
    "subscription-status:unit:test": "node --test scripts/subscription-status.test.mjs",
    "terms-version:unit:test": "node --test scripts/terms-version.test.mjs",
    "waitlist-signup:contract:test": "node --test scripts/waitlist-signup-contract.test.mjs",
    "account-privacy:unit:test": "node --test scripts/account-privacy.test.mjs",
    "csv-safe:unit:test": "node --test scripts/csv-safe.test.mjs",
    "logout-push:unit:test": "node --test scripts/logout-push-cleanup.test.mjs",
    "pwa-push-security:unit:test": "node --test scripts/pwa-push-security.test.mjs",
    "checkout:unit:test": "node --test scripts/checkout.test.mjs",
    "admin-gate:unit:test": "node --test scripts/admin-gate.test.mjs",
    "event-coverage:unit:test": "node --test scripts/event-coverage-domain.test.mjs",
    "sidebar-auth:unit:test": "node --test scripts/sidebar-auth.test.mjs",
    "session-no-js-token:unit:test": "node --test scripts/session-no-js-token.test.mjs",
    "auth-links:unit:test": "node --test scripts/auth-links.test.mjs",
    "stays-integration:unit:test": "node --test scripts/stays-integration-domain.test.mjs",
    "public-plans:unit:test": "node --test scripts/public-plans.test.mjs",
    "format:unit:test": "node --test scripts/format.test.mjs",
    "api-normalize:unit:test": "node --test scripts/api-normalize.test.mjs",
    "next-suggestions:unit:test": "node --test scripts/next-suggestions-domain.test.mjs",
    "safe-next:unit:test": "node --test scripts/safe-next.test.mjs",
    "host-today:unit:test": "node --test scripts/host-today-domain.test.mjs",
    "test:unit": "npm run design:tokens:test && npm run design:debt:self-test && npm run bundle:test && npm run auth:compat:test && npm run onboarding:unit:test && npm run host-baseline:unit:test && npm run event-radar:unit:test && npm run event-radar:api-contract:test && npm run error-boundary:unit:test && npm run pwa:lifecycle:test && npm run ui-primitives:unit:test && npm run forbidden-policy:unit:test && npm run subscription-status:unit:test && npm run terms-version:unit:test && npm run waitlist-signup:contract:test && npm run account-privacy:unit:test && npm run csv-safe:unit:test && npm run logout-push:unit:test && npm run checkout:unit:test && npm run admin-gate:unit:test && npm run event-coverage:unit:test && npm run auth-links:unit:test && npm run stays-integration:unit:test && npm run aplicar-preco:unit:test && npm run public-site:contract:test && npm run app-noindex:contract:test && npm run sidebar-auth:unit:test && npm run session-no-js-token:unit:test && npm run pwa-push-security:unit:test && npm run beta-ops:unit:test && npm run host-today:unit:test && npm run privacy-scrub:unit:test && npm run csp:contract:test && npm run public-plans:unit:test && npm run format:unit:test && npm run api-normalize:unit:test && npm run next-suggestions:unit:test && npm run safe-next:unit:test",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:event-radar": "node scripts/event-radar-release-gate.mjs",
    "test:e2e:event-radar:direct": "node scripts/event-radar-direct-smoke.mjs",
    "test:e2e:event-radar:list": "node scripts/event-radar-release-gate.mjs --list",
    "test:e2e:ask": "playwright test e2e/ask-urban-entitlement.spec.ts",
    "test:e2e:pwa": "playwright test e2e/pwa-mobile.spec.ts",
    "test:e2e:gates": "playwright test e2e/release-gate-public.spec.ts e2e/pwa-mobile.spec.ts e2e/readonly-gates.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "build:watch": "chokidar \"pages/**/*.{js,jsx,ts,tsx}\" \"components/**/*.{js,jsx,ts,tsx}\" \"lib/**/*.{js,jsx,ts,tsx}\" \"next.config.js\" --ignore \"**/node_modules/**\" --ignore \"**/.next/**\" -c \"next build\""
  },
  "dependencies": {
    "@sentry/nextjs": "^10.43.0",
    "@stripe/stripe-js": "^7.8.0",
    "axios": "^1.9.0",
    "chokidar": "^4.0.3",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.9.4",
    "i18next": "^25.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.542.0",
    "next": "^15.4.10",
    "next-auth": "^4.24.11",
    "react": "^19.0.0",
    "react-day-picker": "^9.7.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.5.1",
    "react-leaflet": "5",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.31"
    },
    "next-auth": {
      "uuid": "11.1.1"
    },
    "@sentry/bundler-plugins": {
      "glob": "^14.0.3"
    },
    "glob": {
      "minimatch": "^11.0.3"
    }
  }
}

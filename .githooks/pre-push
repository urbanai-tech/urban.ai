#!/bin/sh
set -eu

# Protege o repositório público: antes de enviar commits para urbanai-tech/urban.ai,
# confirma que a árvore de cada sha enviado só contém arquivos do escopo público.
# Para outros remotos o hook não faz nada.

remote_name="${1:-}"
remote_url="${2:-}"

case "$remote_url" in
  *urbanai-tech/urban.ai*) ;;
  *) exit 0 ;;
esac

repository_root="$(git rev-parse --show-toplevel)"

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push public-scope gate: Node.js is required." >&2
  exit 1
fi

zero="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  # Remoção de branch/tag: nada a verificar.
  case "$local_sha" in
    "$zero"|00000000*) continue ;;
  esac
  if ! node "$repository_root/scripts/public-scope-guard.js" --tree "$local_sha"; then
    echo "pre-push: push de '$local_ref' para $remote_name ($remote_url) bloqueado pelo guarda de escopo público." >&2
    status=1
  fi
done

exit "$status"

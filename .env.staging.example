# Urban AI staging gate template.
# Copy to .env.staging locally when you are ready to run staging gates.
# Never paste real values into chat or documentation.

# Enterprise gate URLs
ENTERPRISE_GATE_BACKEND_URL=
ENTERPRISE_GATE_FRONTEND_URL=

# Readiness/auth tokens
ENTERPRISE_GATE_HEALTH_TOKEN=
ENTERPRISE_GATE_ADMIN_JWT=
ENTERPRISE_GATE_HOST_JWT=

# Controlled events ingest smoke
ENTERPRISE_GATE_EVENTS_INGEST_KEY=
ENTERPRISE_GATE_POST_ASK_QUESTION=false
ENTERPRISE_GATE_PROD_MUTATION_OK=

# Restore drill
RESTORE_DATABASE_URL=

# Stays sandbox/assisted account smoke
STAYS_API_BASE_URL=
STAYS_TOKEN_ENCRYPTION_KEY=
STAYS_AUTO_APPLY_ENABLED=false
STAYS_AUTO_APPLY_DRY_RUN=true
STAYS_AUTO_APPLY_ALLOWED_USER_IDS=
STAYS_AUTO_APPLY_ALLOWED_LISTING_IDS=

# Optional aliases accepted by docs/scripts
HEALTH_READINESS_TOKEN=
EVENTS_INGEST_API_KEY=
STAYS_AUTO_APPLY_USER_ALLOWLIST=
STAYS_AUTO_APPLY_LISTING_ALLOWLIST=

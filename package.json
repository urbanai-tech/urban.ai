    "release:evidence": "node scripts/release-evidence.js",
    "gate:enterprise": "node scripts/enterprise-auditability-live-gate.js",
    "gate:enterprise:dry": "node scripts/enterprise-auditability-live-gate.js --dry-run",
    "gate:enterprise:access": "node scripts/enterprise-access-readiness.js",

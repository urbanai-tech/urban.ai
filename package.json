{
  "name": "opensquad-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "audit:docs-links": "node scripts/audit-document-links.js",
    "audit:docs-links:report": "node scripts/audit-document-links.js --report-only",
    "audit:security-head": "node scripts/security-head-scan.js",
    "audit:security-head:self-test": "node scripts/security-head-scan.js --self-test",
    "audit:security-history": "node scripts/audit-sensitive-history.js",
    "audit:security-history:self-test": "node scripts/audit-sensitive-history.js --self-test",
    "audit:resilience-dr": "node scripts/resilience-dr-gate.js",
    "audit:resilience-dr:self-test": "node scripts/resilience-dr-gate.js --self-test",
    "audit:knn-legacy": "node scripts/knn-legacy-dependency-gate.js",
    "audit:knn-legacy:head": "node scripts/knn-legacy-dependency-gate.js --head",
    "audit:knn-legacy:self-test": "node scripts/knn-legacy-dependency-gate.js --self-test",
    "gate:repository": "npm run audit:security-head && npm run audit:docs-links && npm run audit:resilience-dr && npm run audit:knn-legacy",
